#!/usr/bin/env bash
set -euo pipefail

job_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cleanup() {
  local original_status=$?
  local maintenance_status=0
  local restore_status=0
  local artifact_status=0
  trap - EXIT
  trap '' HUP INT TERM
  set +e
  docker compose --project-directory "$job_dir" \
    -f "$job_dir/compose.maintenance.yaml" down --remove-orphans
  maintenance_status=$?
  docker compose --project-directory "$job_dir" \
    -f "$job_dir/compose.yaml" up -d
  restore_status=$?
  if [ "$maintenance_status" -eq 0 ] && [ "$restore_status" -eq 0 ]; then
    rm -f "$job_dir/compose.maintenance.yaml" \
      "$job_dir/maintenance-endpoint.sh"
    artifact_status=$?
  fi
  if [ "$restore_status" -ne 0 ]; then
    exit "$restore_status"
  fi
  if [ "$maintenance_status" -ne 0 ]; then
    exit "$maintenance_status"
  fi
  if [ "$artifact_status" -ne 0 ]; then
    exit "$artifact_status"
  fi
  exit "$original_status"
}

maintenance_project="offsitebuddy-maintenance-friend-{{ maintenance_item.0.name }}"
project_filter="label=com.docker.compose.project=$maintenance_project"
maintenance_containers="$(
  docker ps --all --quiet --filter "$project_filter"
)"
maintenance_networks="$(
  docker network ls --quiet --filter "$project_filter"
)"
if [ -n "$maintenance_containers$maintenance_networks" ]; then
  printf 'Maintenance Compose project %s already exists; refusing to replace it.\n' \
    "$maintenance_project" >&2
  exit 1
fi
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
docker compose --project-directory "$job_dir" \
  -f "$job_dir/compose.yaml" down
docker compose --project-directory "$job_dir" \
  -f "$job_dir/compose.maintenance.yaml" up -d
printf '%s\n' \
  'Maintenance endpoint active for {{ maintenance_item.0.name }}. Press Enter to restore append-only mode.'
read -r _
