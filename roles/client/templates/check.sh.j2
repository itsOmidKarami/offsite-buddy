#!/usr/bin/env bash
set -euo pipefail

job_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

args=(check)
{% if job_check.read_data | default(false) | bool %}
args+=(--read-data)
{% endif %}

docker compose \
  --project-name "offsitebuddy-client-{{ job.name }}" \
  --project-directory "$job_dir" \
  -f "$job_dir/compose.yaml" \
  run --rm restic "${args[@]}"
